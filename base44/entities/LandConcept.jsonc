{
  "name": "LandConcept",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the land concept"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed",
        "transferred"
      ],
      "default": "draft"
    },
    "data_confidence": {
      "type": "string",
      "enum": [
        "concept"
      ],
      "default": "concept"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "description": "User inputs: land area, IZ, KPP, floors, project type, etc."
    },
    "results": {
      "type": "object",
      "additionalProperties": true,
      "description": "Calculated feasibility outputs"
    },
    "linked_project_id": {
      "type": "string",
      "description": "ID of the Development Calculator project this was transferred to"
    },
    "notes": {
      "type": "string",
      "description": "User notes"
    }
  },
  "required": [
    "name"
  ],
  "permissions": {
    "admin": {
      "create": "own",
      "read": "all",
      "update": "all",
      "delete": "all"
    },
    "user": {
      "create": "own",
      "read": "own",
      "update": "own",
      "delete": "own"
    }
  },
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}